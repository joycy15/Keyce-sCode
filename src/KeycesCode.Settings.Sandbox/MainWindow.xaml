<Window x:Class="KeycesCode.Settings.Sandbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:git="clr-namespace:KeycesCode.Settings.Git;assembly=KeycesCode.Settings"
        Title="Keyce'sCode — Bac à sable (Membre 5)" Height="720" Width="1150"
        Background="{DynamicResource Brush.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="22"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="320" MinWidth="200"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Barre d'activité : seulement Git et Paramètres -->
            <DockPanel Background="{DynamicResource Brush.ActivityBar}" LastChildFill="False">
                <RadioButton DockPanel.Dock="Top" Style="{StaticResource ActivityButton}"
                             Tag="GitView" Content="⎇" FontFamily="Segoe UI Symbol" IsChecked="True"
                             ToolTip="Contrôle de code source" Checked="Activity_Checked"/>
                <RadioButton DockPanel.Dock="Bottom" Style="{StaticResource ActivityButton}"
                             Tag="SettingsView" Content="&#xE713;"
                             ToolTip="Paramètres" Checked="Activity_Checked"/>
            </DockPanel>

            <!-- Barre latérale -->
            <Border Grid.Column="1" Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
                <Grid x:Name="SideBarViews">
                    <git:GitPanel x:Name="GitView" BranchChanged="GitView_BranchChanged"/>

                    <Grid x:Name="SettingsView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="PARAMÈTRES" Style="{StaticResource SectionHeader}"/>
                        <StackPanel Grid.Row="1" Margin="16,4">
                            <TextBlock x:Name="ThemeLabel" Margin="0,0,0,8"
                                       Foreground="{DynamicResource Brush.Foreground}"/>
                            <Button Content="Basculer le thème" HorizontalAlignment="Left"
                                    Click="ToggleTheme_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="2" Width="4" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"/>
        </Grid>

        <!-- Barre de statut grise -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.ActivityBar}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" x:Name="ThemeStatus" Style="{StaticResource StatusItem}"
                           Foreground="{DynamicResource Brush.ForegroundMuted}"/>
                <TextBlock x:Name="BranchStatus" Style="{StaticResource StatusItem}"
                           Foreground="{DynamicResource Brush.ForegroundMuted}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
