<UserControl x:Class="KeycesCode.Assistant.AssistantPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.Panel}"
             IsVisibleChanged="Panel_IsVisibleChanged">

    <!-- Fenêtre de conversation inspirée du « Chat » de VS Code (Copilot) :
         en-tête « Chat », messages, puis une carte de saisie arrondie en bas
         (fichier joint, zone de texte, mode Agent, bouton envoyer). -->

    <UserControl.Resources>
        <!-- Texte sélectionnable sans cadre (pour copier) -->
        <Style x:Key="SelectableText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Code : police à chasse fixe, pas de retour à la ligne, défilement horizontal -->
        <Style x:Key="CodeText" TargetType="TextBox" BasedOn="{StaticResource SelectableText}">
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Petit bouton icône (en-tête, carte de saisie) -->
        <Style x:Key="ChatIconButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pastille « + index.php » : fichier joint à la question (cliquer pour l'enlever ou le remettre) -->
        <Style x:Key="ContextChip" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" CornerRadius="4" BorderThickness="1" Padding="6,2,8,2"
                                BorderBrush="{DynamicResource Brush.Border}" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Sign" Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           VerticalAlignment="Center" Margin="0,0,6,0"
                                           Foreground="{DynamicResource Brush.ForegroundMuted}"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Sign" Property="Text" Value="&#xE723;"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- « Agent » : l'assistant écrit lui-même dans l'éditeur (bleu quand activé) -->
        <Style x:Key="ModeToggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Brush.ForegroundMuted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" CornerRadius="5" Padding="6,3" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,6,0"
                                           Foreground="{TemplateBinding Foreground}"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête : « Chat » + actions, comme VS Code -->
        <DockPanel Grid.Row="0" Margin="12,0,6,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="NewButton" Style="{StaticResource ChatIconButton}" Content="&#xE710;"
                        ToolTip="Nouvelle discussion" Click="NewConversation_Click"/>
                <Button Style="{StaticResource ChatIconButton}" Content="&#xE72C;"
                        ToolTip="Vérifier la connexion à Gemini" Click="CheckStatus_Click"/>
                <Button Style="{StaticResource ChatIconButton}" Content="&#xE8BB;" FontSize="11"
                        ToolTip="Fermer le chat" Click="Close_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Chat" FontSize="13" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Foreground}"/>
                <Border Height="1" Width="0"/>
            </StackPanel>
        </DockPanel>

        <!-- Modèle utilisé : « ● Google Gemini · gemini-flash-latest » -->
        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="12,0,12,6" FontSize="11"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource Brush.ForegroundMuted}" Text="Connexion à Gemini…"/>

        <!-- Messages -->
        <Grid Grid.Row="2">
            <ScrollViewer x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MessagesList" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Bubble" Margin="12,6" Padding="0" CornerRadius="8"
                                    Background="Transparent" BorderThickness="0"
                                    BorderBrush="{DynamicResource Brush.Border}">
                                <StackPanel>
                                    <StackPanel x:Name="AuthorLine" Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Width="20" Height="20" CornerRadius="10" Margin="0,0,8,0"
                                                Background="#1A73E8">
                                            <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                       Foreground="White" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Gemini" FontSize="13" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.Foreground}"/>
                                    </StackPanel>

                                    <!-- Pendant l'écriture : texte brut -->
                                    <TextBox x:Name="PlainText" Style="{StaticResource SelectableText}"
                                             Text="{Binding Text, Mode=OneWay}"/>

                                    <!-- Une fois terminé : texte + blocs de code avec boutons -->
                                    <ItemsControl x:Name="SegmentsView" ItemsSource="{Binding Segments}"
                                                  Visibility="Collapsed">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <TextBox x:Name="SegmentText" Style="{StaticResource SelectableText}"
                                                             Text="{Binding Text, Mode=OneWay}" Margin="0,2"/>

                                                    <Border x:Name="CodeBox" Visibility="Collapsed" Margin="0,6"
                                                            CornerRadius="6" BorderThickness="1"
                                                            Background="{DynamicResource Brush.Background}"
                                                            BorderBrush="{DynamicResource Brush.Border}">
                                                        <StackPanel>
                                                            <DockPanel Margin="10,4,4,2">
                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                    <Button x:Name="ApplyButton" Style="{StaticResource ChatIconButton}" FontSize="12" Content="&#xE8FB;"
                                                                            Tag="Apply" Click="CodeAction_Click"
                                                                            ToolTip="Écrire encore une fois ce code dans l'éditeur (comme indiqué)"/>
                                                                    <Button Style="{StaticResource ChatIconButton}" FontSize="12" Content="&#xE77F;"
                                                                            Tag="InsertAtCursor" Click="CodeAction_Click"
                                                                            ToolTip="Insérer dans l'éditeur, à la position du curseur"/>
                                                                    <Button Style="{StaticResource ChatIconButton}" FontSize="12" Content="&#xE70F;"
                                                                            Tag="ReplaceSelection" Click="CodeAction_Click"
                                                                            ToolTip="Remplacer le texte sélectionné dans l'éditeur"/>
                                                                    <Button Style="{StaticResource ChatIconButton}" FontSize="12" Content="&#xE8A5;"
                                                                            Tag="ReplaceFile" Click="CodeAction_Click"
                                                                            ToolTip="Remplacer tout le fichier ouvert par ce code"/>
                                                                    <Button Style="{StaticResource ChatIconButton}" FontSize="12" Content="&#xE8C8;"
                                                                            Tag="Copy" Click="CodeAction_Click"
                                                                            ToolTip="Copier le code"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Header}" FontSize="11"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource Brush.ForegroundMuted}"/>
                                                            </DockPanel>
                                                            <TextBox Style="{StaticResource CodeText}" Margin="10,0,10,10"
                                                                     Text="{Binding Text, Mode=OneWay}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsCode}" Value="True">
                                                        <Setter TargetName="SegmentText" Property="Visibility" Value="Collapsed"/>
                                                        <Setter TargetName="CodeBox" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Action}" Value="{x:Null}">
                                                        <Setter TargetName="ApplyButton" Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <!-- Ta question : dans une carte arrondie, sans en-tête (comme VS Code) -->
                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                    <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource Brush.Input}"/>
                                    <Setter TargetName="Bubble" Property="BorderThickness" Value="1"/>
                                    <Setter TargetName="Bubble" Property="Padding" Value="10,8"/>
                                    <Setter TargetName="Bubble" Property="Margin" Value="40,10,12,6"/>
                                    <Setter TargetName="AuthorLine" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                    <Setter TargetName="PlainText" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="SegmentsView" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Aucun message : présentation au milieu -->
            <StackPanel x:Name="EmptyText" VerticalAlignment="Center" Margin="28,0">
                <Border Width="44" Height="44" CornerRadius="22" Background="#1A73E8" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Demande à Gemini" FontSize="18" Margin="0,14,0,6" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.Foreground}"/>
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="12" LineHeight="18"
                           Foreground="{DynamicResource Brush.ForegroundMuted}"
                           Text="L'assistant voit le fichier ouvert et tout le dossier du projet. En mode Agent, il écrit directement dans les fichiers (Ctrl+Z pour annuler dans l'éditeur)."/>
            </StackPanel>
        </Grid>

        <!-- Erreur -->
        <TextBlock x:Name="ErrorText" Grid.Row="3" Margin="14,4" TextWrapping="Wrap" FontSize="12"
                   Visibility="Collapsed" Foreground="{DynamicResource Brush.GitDeleted}"/>

        <!-- Carte de saisie arrondie (comme « Chat with Copilot ») -->
        <Border Grid.Row="4" Margin="10,4,10,10" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource Brush.Input}" BorderBrush="{DynamicResource Brush.Border}"
                Padding="8,8,6,6">
            <StackPanel>
                <!-- Ce que l'assistant voit : le fichier ouvert (« index.php ») et tout le dossier du projet -->
                <WrapPanel Margin="2,0,0,6">
                    <CheckBox x:Name="IncludeFileCheck" Style="{StaticResource ContextChip}" IsChecked="True"
                              Margin="0,0,6,0"
                              ToolTip="L'assistant reçoit ce fichier (et la sélection) avec ta question. Clique pour l'enlever.">
                        <TextBlock x:Name="ContextLabel" Text="Aucun fichier ouvert" FontSize="12" FontStyle="Italic"
                                   TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                    </CheckBox>
                    <CheckBox x:Name="ProjectCheck" Style="{StaticResource ContextChip}" IsChecked="True"
                              ToolTip="L'assistant voit tout le dossier ouvert (liste et contenu des fichiers) et peut modifier n'importe quel fichier du projet. Clique pour l'enlever.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="ProjectLabel" Text="Aucun dossier" FontSize="12" FontStyle="Italic"
                                       TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                        </StackPanel>
                    </CheckBox>
                </WrapPanel>

                <!-- Zone de texte -->
                <Grid Margin="2,0,0,0">
                    <TextBox x:Name="InputBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="180"
                             VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"
                             Padding="0,4" FontSize="13"
                             Foreground="{DynamicResource Brush.Foreground}"
                             CaretBrush="{DynamicResource Brush.Foreground}"
                             PreviewKeyDown="InputBox_PreviewKeyDown" TextChanged="InputBox_TextChanged"
                             GotKeyboardFocus="InputBox_GotKeyboardFocus"/>
                    <TextBlock x:Name="Placeholder" Margin="0,4" VerticalAlignment="Top" IsHitTestVisible="False"
                               FontSize="13" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Brush.ForegroundMuted}"
                               Text="Discuter avec Gemini"/>
                </Grid>

                <!-- Barre du bas : nouvelle discussion, mode Agent, envoyer -->
                <DockPanel Margin="0,6,0,0">
                    <Grid DockPanel.Dock="Right">
                        <Button x:Name="SendButton" Style="{StaticResource ChatIconButton}" Content="&#xE74A;"
                                ToolTip="Envoyer (Entrée) — Maj+Entrée : nouvelle ligne" Click="Send_Click"/>
                        <Button x:Name="StopButton" Style="{StaticResource ChatIconButton}" Content="&#xE71A;"
                                ToolTip="Arrêter la réponse" Click="Stop_Click" Visibility="Collapsed"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ChatIconButton}" Content="&#xE710;"
                                ToolTip="Nouvelle discussion" Click="NewConversation_Click"/>
                        <CheckBox x:Name="WriteToEditorCheck" Style="{StaticResource ModeToggle}" IsChecked="True"
                                  Margin="4,0,0,0" VerticalAlignment="Center"
                                  ToolTip="Mode Agent : l'assistant écrit lui-même le code dans l'éditeur (Ctrl+Z pour annuler). Désactivé : il répond seulement.">
                            <TextBlock Text="Agent" FontSize="12"/>
                        </CheckBox>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
