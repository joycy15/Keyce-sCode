<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Thème clair de Keyce'sCode : blancs et gris neutres (inspiré de VS Code Light Modern) -->
    <SolidColorBrush x:Key="Brush.Background"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Panel"           Color="#F8F8F8"/>
    <SolidColorBrush x:Key="Brush.ActivityBar"     Color="#F8F8F8"/>
    <SolidColorBrush x:Key="Brush.Border"          Color="#E5E5E5"/>
    <SolidColorBrush x:Key="Brush.Foreground"      Color="#3B3B3B"/>
    <SolidColorBrush x:Key="Brush.ForegroundMuted" Color="#767676"/>
    <SolidColorBrush x:Key="Brush.Primary"         Color="#3B3B3B"/> <!-- boutons : gris foncé, texte blanc -->
    <SolidColorBrush x:Key="Brush.Accent"          Color="#1F1F1F"/>
    <SolidColorBrush x:Key="Brush.Interactive"     Color="#1F1F1F"/>
    <SolidColorBrush x:Key="Brush.Hover"           Color="#EDEDED"/>
    <SolidColorBrush x:Key="Brush.Selection"       Color="#E0E0E0"/> <!-- gris, plus de bleuté -->
    <SolidColorBrush x:Key="Brush.Input"           Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.GitModified"     Color="#895503"/>
    <SolidColorBrush x:Key="Brush.GitAdded"        Color="#587C0C"/>
    <SolidColorBrush x:Key="Brush.GitDeleted"      Color="#AD0707"/>
</ResourceDictionary>
