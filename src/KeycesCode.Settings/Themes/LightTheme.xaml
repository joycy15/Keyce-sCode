<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Thème clair de Keyce'sCode : blanc doux, texte noir, accents bleus -->
    <SolidColorBrush x:Key="Brush.Background"      Color="#F3F3F3"/>
    <SolidColorBrush x:Key="Brush.Panel"           Color="#EBEBEB"/>
    <SolidColorBrush x:Key="Brush.ActivityBar"     Color="#E5E5E5"/>
    <SolidColorBrush x:Key="Brush.Border"          Color="#D4D4D4"/>
    <SolidColorBrush x:Key="Brush.Foreground"      Color="#1F1F1F"/>
    <SolidColorBrush x:Key="Brush.ForegroundMuted" Color="#5F5F5F"/>
    <SolidColorBrush x:Key="Brush.Primary"         Color="#0078D4"/> <!-- boutons : bleu, texte blanc -->
    <SolidColorBrush x:Key="Brush.Accent"          Color="#0078D4"/>
    <SolidColorBrush x:Key="Brush.Interactive"     Color="#0078D4"/>
    <SolidColorBrush x:Key="Brush.Link"            Color="#005FB8"/>
    <SolidColorBrush x:Key="Brush.Hover"           Color="#DCDCDC"/>
    <SolidColorBrush x:Key="Brush.Selection"       Color="#D0DFF0"/>
    <SolidColorBrush x:Key="Brush.Input"           Color="#F5F5F5"/>
    <SolidColorBrush x:Key="Brush.GitModified"     Color="#895503"/>
    <SolidColorBrush x:Key="Brush.GitAdded"        Color="#388A34"/>
    <SolidColorBrush x:Key="Brush.GitDeleted"      Color="#C62828"/>
</ResourceDictionary>
