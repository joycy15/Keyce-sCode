<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Thème sombre de Keyce'sCode : noirs et gris -->
    <SolidColorBrush x:Key="Brush.Background"      Color="#1F1F1F"/>
    <SolidColorBrush x:Key="Brush.Panel"           Color="#181818"/>
    <SolidColorBrush x:Key="Brush.ActivityBar"     Color="#181818"/>
    <SolidColorBrush x:Key="Brush.Border"          Color="#2B2B2B"/>
    <SolidColorBrush x:Key="Brush.Foreground"      Color="#CCCCCC"/>
    <SolidColorBrush x:Key="Brush.ForegroundMuted" Color="#9D9D9D"/>
    <SolidColorBrush x:Key="Brush.Primary"         Color="#3C3C3C"/> <!-- boutons : gris -->
    <SolidColorBrush x:Key="Brush.Accent"          Color="#E0E0E0"/> <!-- indicateur actif : blanc cassé -->
    <SolidColorBrush x:Key="Brush.Interactive"     Color="#E0E0E0"/>
    <SolidColorBrush x:Key="Brush.Hover"           Color="#2A2D2E"/>
    <SolidColorBrush x:Key="Brush.Selection"       Color="#37373D"/>
    <SolidColorBrush x:Key="Brush.Input"           Color="#313131"/>
    <SolidColorBrush x:Key="Brush.GitModified"     Color="#E2C08D"/>
    <SolidColorBrush x:Key="Brush.GitAdded"        Color="#73C991"/>
    <SolidColorBrush x:Key="Brush.GitDeleted"      Color="#F07178"/>
</ResourceDictionary>
