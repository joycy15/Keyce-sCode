<UserControl x:Class="KeycesCode.Settings.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" PreviewKeyDown="Page_PreviewKeyDown">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SettingItem" TargetType="Border">
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Hover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
        </Style>

        <Style x:Key="SettingDescription" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.ForegroundMuted}"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Margin" Value="14,24,0,8"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
        </Style>

        <Style x:Key="OptionButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Padding="16,4" CornerRadius="3" BorderThickness="1"
                                BorderBrush="{DynamicResource Brush.Border}"
                                Background="{DynamicResource Brush.Input}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Selection}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Padding="12,5" Background="Transparent" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Brush.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barre de recherche -->
        <Grid Margin="24,16,24,8">
            <TextBox x:Name="SearchInput" Padding="8,6" TextChanged="SearchInput_TextChanged"/>
            <TextBlock Text="Rechercher dans les paramètres" Margin="11,7,0,0" IsHitTestVisible="False"
                       Foreground="{DynamicResource Brush.ForegroundMuted}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text.IsEmpty, ElementName=SearchInput}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <Border Grid.Row="1" Margin="24,0,24,0" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource Brush.Border}">
            <Border HorizontalAlignment="Left" BorderThickness="0,0,0,1" Padding="2,6"
                    BorderBrush="{DynamicResource Brush.Accent}">
                <TextBlock Text="Utilisateur" Foreground="{DynamicResource Brush.Foreground}"/>
            </Border>
        </Border>

        <Grid Grid.Row="2" Margin="12,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Table des matières -->
            <StackPanel Margin="0,16,8,0">
                <Button Style="{StaticResource CategoryButton}" Content="Apparence" Tag="AppearanceSection" Click="Category_Click"/>
                <Button Style="{StaticResource CategoryButton}" Content="Éditeur" Tag="EditorSection" Click="Category_Click"/>
                <Button Style="{StaticResource CategoryButton}" Content="Fichiers" Tag="FilesSection" Click="Category_Click"/>
                <Button Style="{StaticResource CategoryButton}" Content="Assistant IA" Tag="AssistantSection" Click="Category_Click"/>
                <Button Style="{StaticResource CategoryButton}" Content="Raccourcis clavier" Tag="ShortcutsSection" Click="Category_Click"/>
            </StackPanel>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SettingsList" Margin="0,0,24,24" MaxWidth="800" HorizontalAlignment="Left">

                    <!-- ===== Apparence ===== -->
                    <StackPanel x:Name="AppearanceSection">
                        <TextBlock Text="Apparence" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource SettingItem}" Tag="apparence thème couleur sombre clair">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingTitle}">
                                    <Run Text="Apparence : "/><Run Text="Thème de couleur" FontWeight="SemiBold"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource SettingDescription}"
                                           Text="Choisit les couleurs de l'interface et de l'éditeur."/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="DarkThemeOption" Style="{StaticResource OptionButton}"
                                                 GroupName="Theme" Tag="dark" Content="Sombre" Checked="Theme_Checked"/>
                                    <RadioButton x:Name="LightThemeOption" Style="{StaticResource OptionButton}"
                                                 GroupName="Theme" Tag="light" Content="Clair" Checked="Theme_Checked"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== Éditeur ===== -->
                    <StackPanel x:Name="EditorSection">
                        <TextBlock Text="Éditeur" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource SettingItem}" Tag="éditeur police famille font">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingTitle}">
                                    <Run Text="Éditeur : "/><Run Text="Police" FontWeight="SemiBold"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource SettingDescription}"
                                           Text="Nom de la police utilisée dans l'éditeur (par exemple Cascadia Code ou Consolas)."/>
                                <TextBox x:Name="FontFamilyInput" Width="300" HorizontalAlignment="Left"
                                         LostFocus="FontFamily_LostFocus" PreviewKeyDown="Field_PreviewKeyDown"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingItem}" Tag="éditeur taille police texte">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingTitle}">
                                    <Run Text="Éditeur : "/><Run Text="Taille de police" FontWeight="SemiBold"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource SettingDescription}"
                                           Text="Taille du texte dans l'éditeur, en points (de 6 à 72)."/>
                                <TextBox x:Name="FontSizeInput" Width="80" HorizontalAlignment="Left"
                                         LostFocus="FontSize_LostFocus" PreviewKeyDown="Field_PreviewKeyDown"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingItem}" Tag="éditeur minimap aperçu">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingTitle}">
                                    <Run Text="Éditeur : "/><Run Text="Minimap" FontWeight="SemiBold"/>
                                </TextBlock>
                                <CheckBox x:Name="MinimapCheck" Margin="0,6,0,0" Click="Minimap_Click"
                                          Content="Afficher la minimap à droite de l'éditeur."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== Fichiers ===== -->
                    <StackPanel x:Name="FilesSection">
                        <TextBlock Text="Fichiers" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource SettingItem}" Tag="fichiers enregistrement sauvegarde automatique">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingTitle}">
                                    <Run Text="Fichiers : "/><Run Text="Enregistrement automatique" FontWeight="SemiBold"/>
                                </TextBlock>
                                <CheckBox x:Name="AutoSaveCheck" Margin="0,6,0,0" Click="AutoSave_Click"
                                          Content="Enregistrer automatiquement les fichiers modifiés."/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingItem}" Tag="fichiers délai enregistrement sauvegarde automatique secondes">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingTitle}">
                                    <Run Text="Fichiers : "/><Run Text="Délai de l'enregistrement automatique" FontWeight="SemiBold"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource SettingDescription}"
                                           Text="Nombre de secondes avant l'enregistrement automatique (de 1 à 600)."/>
                                <TextBox x:Name="AutoSaveDelayInput" Width="80" HorizontalAlignment="Left"
                                         LostFocus="AutoSaveDelay_LostFocus" PreviewKeyDown="Field_PreviewKeyDown"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== Assistant IA ===== -->
                    <StackPanel x:Name="AssistantSection">
                        <TextBlock Text="Assistant IA" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource SettingItem}" Tag="assistant ia modèle ollama">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingTitle}">
                                    <Run Text="Assistant IA : "/><Run Text="Modèle" FontWeight="SemiBold"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource SettingDescription}"
                                           Text="Nom du modèle Ollama utilisé par l'assistant (par exemple qwen2.5-coder:1.5b)."/>
                                <TextBox x:Name="AssistantModelInput" Width="300" HorizontalAlignment="Left"
                                         LostFocus="AssistantModel_LostFocus" PreviewKeyDown="Field_PreviewKeyDown"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== Raccourcis clavier ===== -->
                    <StackPanel x:Name="ShortcutsSection">
                        <TextBlock Text="Raccourcis clavier" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource SettingItem}" Tag="raccourcis clavier touches commandes">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingTitle}">
                                    <Run Text="Raccourcis clavier : "/><Run Text="Commandes" FontWeight="SemiBold"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource SettingDescription}"
                                           Text="Clique sur « Modifier », puis appuie sur la nouvelle combinaison de touches. Échap pour annuler."/>

                                <ItemsControl x:Name="ShortcutsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="210"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.Foreground}"/>

                                                <!-- Le raccourci, affiché comme une touche de clavier -->
                                                <Border Grid.Column="1" HorizontalAlignment="Left" Padding="8,2"
                                                        CornerRadius="3" BorderThickness="1"
                                                        BorderBrush="{DynamicResource Brush.Border}"
                                                        Background="{DynamicResource Brush.Input}">
                                                    <TextBlock Text="{Binding Shortcut}" FontFamily="Cascadia Mono, Consolas"
                                                               Foreground="{DynamicResource Brush.Foreground}"/>
                                                </Border>

                                                <Button Grid.Column="2" Content="Modifier" Padding="10,2" Margin="8,0,0,0"
                                                        Tag="{Binding CommandId}" Click="EditShortcut_Click"/>
                                                <Button Grid.Column="3" Content="Réinitialiser" Padding="10,2" Margin="6,0,0,0"
                                                        Tag="{Binding CommandId}" Click="ResetShortcut_Click"
                                                        Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="StatusText" Margin="24,6,24,10" FontSize="12"
                   Foreground="{DynamicResource Brush.ForegroundMuted}"/>
    </Grid>
</UserControl>
