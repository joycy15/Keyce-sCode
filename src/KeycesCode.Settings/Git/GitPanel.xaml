<UserControl x:Class="KeycesCode.Settings.Git.GitPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <DockPanel Margin="0,0,8,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{DynamicResource IconButton}" Content="&#xE8B7;"
                        ToolTip="Ouvrir un dossier" Click="ChooseFolder_Click"/>
                <Button Style="{DynamicResource IconButton}" Content="&#xE72C;"
                        ToolTip="Actualiser" Click="Refresh_Click"/>
            </StackPanel>
            <TextBlock Text="CONTRÔLE DE CODE SOURCE" Style="{DynamicResource SectionHeader}"/>
        </DockPanel>

        <!-- Aucun dépôt ouvert -->
        <StackPanel x:Name="EmptyView" Grid.Row="1" Margin="16,4">
            <TextBlock x:Name="EmptyText" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Foreground}"/>
            <Button Content="Ouvrir un dossier" Margin="0,12,0,0" Click="ChooseFolder_Click"/>
        </StackPanel>

        <!-- Dépôt ouvert -->
        <Grid x:Name="RepoView" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="FolderText" Margin="16,0,16,6" FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Brush.ForegroundMuted}"/>

            <!-- Message du commit, avec un texte d'aide quand il est vide -->
            <Grid Grid.Row="1" Margin="16,0">
                <TextBox x:Name="MessageInput" PreviewKeyDown="MessageInput_PreviewKeyDown"/>
                <TextBlock Text="Message (Ctrl+Entrée pour valider)" Margin="8,5,0,0"
                           IsHitTestVisible="False"
                           Foreground="{DynamicResource Brush.ForegroundMuted}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text.IsEmpty, ElementName=MessageInput}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Button Grid.Row="2" Margin="16,8,16,12" Content="✓  Commit" Click="Commit_Click"/>

            <!-- "Modifications" + compteur -->
            <DockPanel Grid.Row="3" Margin="16,0,16,4">
                <Border DockPanel.Dock="Right" MinWidth="18" Padding="6,0" CornerRadius="9"
                        Background="{DynamicResource Brush.Selection}">
                    <TextBlock x:Name="ChangesCount" Text="0" FontSize="11" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush.Foreground}"/>
                </Border>
                <TextBlock Text="Modifications" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Foreground}"/>
            </DockPanel>

            <ListBox Grid.Row="4" x:Name="FilesList">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ToolTip="{Binding Path}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,6,0"/>

                            <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                <Run Text="{Binding FileName, Mode=OneWay}"
                                     Foreground="{DynamicResource Brush.Foreground}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding Folder, Mode=OneWay}" FontSize="11"
                                     Foreground="{DynamicResource Brush.ForegroundMuted}"/>
                            </TextBlock>

                            <!-- Lettre M / U / A / D, colorée selon l'état -->
                            <TextBlock Grid.Column="2" Text="{Binding Letter}" FontWeight="SemiBold"
                                       Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.GitModified}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Letter}" Value="U">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.GitAdded}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Letter}" Value="A">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.GitAdded}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Letter}" Value="D">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.GitDeleted}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="5" x:Name="InfoText" Margin="16,8" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.ForegroundMuted}"/>
        </Grid>
    </Grid>
</UserControl>
