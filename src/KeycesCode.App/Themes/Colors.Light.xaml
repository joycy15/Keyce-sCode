<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Thème clair : blanc doux (pas éclatant), texte noir, accents bleus.
         Mêmes clés que Colors.xaml (thème sombre). -->
    <SolidColorBrush x:Key="AppBackground" Color="#EBEBEB"/>
    <SolidColorBrush x:Key="TitleBarBackground" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="MenuBackground" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#EBEBEB"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#EBEBEB"/>
    <SolidColorBrush x:Key="EditorBackground" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="TabBackground" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#DCDCDC"/>
    <SolidColorBrush x:Key="SelectedBackground" Color="#D0DFF0"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="StrongBorderBrush" Color="#BDBDBD"/>
    <SolidColorBrush x:Key="StatusBarBackground" Color="#0078D4"/>
    <SolidColorBrush x:Key="StatusBarText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBackground" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="TextSelection" Color="#ADD6FF"/>
    <SolidColorBrush x:Key="ButtonBackground" Color="#0078D4"/>
    <SolidColorBrush x:Key="ButtonText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="WelcomeTitle" Color="#0078D4"/>
    <SolidColorBrush x:Key="LogoText" Color="White"/>
    <SolidColorBrush x:Key="FolderIcon" Color="#C09553"/>

    <SolidColorBrush x:Key="PrimaryText" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="SecondaryText" Color="#555555"/>
    <SolidColorBrush x:Key="MutedText" Color="#7A7A7A"/>

    <SolidColorBrush x:Key="LinkText" Color="#005FB8"/>
    <SolidColorBrush x:Key="MenuPopupBackground" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="MenuHighlight" Color="#CCE4F7"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#C1C1C1"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#A8A8A8"/>
    <SolidColorBrush x:Key="TerminalCommand" Color="#795E26"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D4"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#388A34"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#D32F2F"/>

</ResourceDictionary>
