<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Thème clair de l'interface : blancs et gris (mêmes clés que Colors.xaml) -->
    <SolidColorBrush x:Key="AppBackground" Color="#F8F8F8"/>
    <SolidColorBrush x:Key="TitleBarBackground" Color="#F8F8F8"/>
    <SolidColorBrush x:Key="MenuBackground" Color="#F8F8F8"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#F8F8F8"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#F8F8F8"/>
    <SolidColorBrush x:Key="EditorBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TabBackground" Color="#F8F8F8"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#EDEDED"/>
    <SolidColorBrush x:Key="SelectedBackground" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="StrongBorderBrush" Color="#CECECE"/>
    <SolidColorBrush x:Key="StatusBarBackground" Color="#F8F8F8"/>
    <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSelection" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="ButtonBackground" Color="#3B3B3B"/>
    <SolidColorBrush x:Key="ButtonText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="WelcomeTitle" Color="#3B3B3B"/>
    <SolidColorBrush x:Key="LogoText" Color="#F8F8F8"/>
    <SolidColorBrush x:Key="FolderIcon" Color="#6E6E6E"/>

    <SolidColorBrush x:Key="PrimaryText" Color="#3B3B3B"/>
    <SolidColorBrush x:Key="SecondaryText" Color="#616161"/>
    <SolidColorBrush x:Key="MutedText" Color="#8B8B8B"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#388A34"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#E51400"/>

</ResourceDictionary>
