    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Thème sombre : copie du thème « Dark+ » de VS Code (barre d'activité #333333,
         barre latérale #252526, éditeur #1E1E1E, barre d'état bleue #007ACC).
         Colors.xaml et Colors.Light.xaml doivent avoir exactement les mêmes clés. -->

