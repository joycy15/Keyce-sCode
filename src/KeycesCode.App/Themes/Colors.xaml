<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppBackground" Color="#181818"/>
    <SolidColorBrush x:Key="TitleBarBackground" Color="#181818"/>
    <SolidColorBrush x:Key="MenuBackground" Color="#181818"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#181818"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#252526"/>
    <SolidColorBrush x:Key="EditorBackground" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="TabBackground" Color="#181818"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#2A2D2E"/>
    <SolidColorBrush x:Key="SelectedBackground" Color="#37373D"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="StrongBorderBrush" Color="#454545"/>

    <SolidColorBrush x:Key="PrimaryText" Color="#CCCCCC"/>
