<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Thème sombre d'origine du Membre 1 (noir et bleu). Le thème clair est dans Colors.Light.xaml :
         les deux fichiers doivent avoir exactement les mêmes clés. -->
    <SolidColorBrush x:Key="AppBackground" Color="#181818"/>
    <SolidColorBrush x:Key="TitleBarBackground" Color="#181818"/>
    <SolidColorBrush x:Key="MenuBackground" Color="#181818"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#181818"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#252526"/>
    <SolidColorBrush x:Key="EditorBackground" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="TabBackground" Color="#181818"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#2A2D2E"/>
    <SolidColorBrush x:Key="SelectedBackground" Color="#37373D"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="StrongBorderBrush" Color="#454545"/>
    <SolidColorBrush x:Key="StatusBarBackground" Color="#0078D4"/>
    <SolidColorBrush x:Key="InputBackground" Color="#3C3C3C"/>
    <SolidColorBrush x:Key="TextSelection" Color="#264F78"/>
    <SolidColorBrush x:Key="ButtonBackground" Color="#0E639C"/>
    <SolidColorBrush x:Key="ButtonText" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="WelcomeTitle" Color="#6C8CFF"/>
    <SolidColorBrush x:Key="LogoText" Color="White"/>
    <SolidColorBrush x:Key="FolderIcon" Color="#C0C0C0"/>

    <SolidColorBrush x:Key="PrimaryText" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="SecondaryText" Color="#9D9D9D"/>
    <SolidColorBrush x:Key="MutedText" Color="#858585"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#0078D4"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#89D185"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#F14C4C"/>

</ResourceDictionary>
