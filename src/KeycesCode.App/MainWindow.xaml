<Window x:Class="KeycesCode.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:git="clr-namespace:KeycesCode.Settings.Git;assembly=KeycesCode.Settings"
        xmlns:set="clr-namespace:KeycesCode.Settings;assembly=KeycesCode.Settings"
        xmlns:ai="clr-namespace:KeycesCode.Assistant;assembly=KeycesCode.Assistant"
        Title="KEYCE CODE"
        Height="850"
        Width="1450"
        MinHeight="600"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource PrimaryText}"
        FontFamily="Segoe UI Variable Text"
        FontSize="13"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Page d'accueil : liens comme dans VS Code -->
        <Style x:Key="WelcomeLink" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource LinkText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" Padding="0,3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WelcomeCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource SidebarBackground}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="16,12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BottomPanelTab" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="TabSurface"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="TabUnderline"
                                    Height="1"
                                    VerticalAlignment="Bottom"
                                    Background="Transparent"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="TabUnderline" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ExplorerActionButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowDuration" Value="10000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="Transparent"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource HoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource SelectedBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActivityButton" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="ToolTipService.ShowDuration" Value="10000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="HoverFill"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"/>
                            <Border x:Name="ActiveIndicator"
                                    Width="2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    Background="{TemplateBinding Foreground}"
                                    Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverFill" Property="Background" Value="{DynamicResource HoverBackground}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverFill" Property="Background" Value="{DynamicResource SelectedBackground}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="22"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource TitleBarBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="12,0">
                <Border Width="16"
                        Height="16"
                        CornerRadius="3"
                        Background="{DynamicResource AccentBrush}"
                        VerticalAlignment="Center"
                        Margin="0,0,9,0">
                    <TextBlock Text="K"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource LogoText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="KEYCE CODE"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryText}"/>
                <TextBlock Text="— Development Environment"
                           Foreground="{DynamicResource SecondaryText}"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource SidebarBackground}">
            <Menu Background="Transparent" Foreground="{DynamicResource PrimaryText}">
                <MenuItem Header="_File">
                    <MenuItem Header="Nouveau fichier..." Click="WelcomeNewFile_Click"/>
                    <MenuItem Header="Ouvrir un fichier..." Click="WelcomeOpenFile_Click"/>
                    <MenuItem Header="_Open Folder..." Click="OpenFolder_Click"/>
                    <MenuItem Header="Fermer le dossier" Click="CloseFolder_Click"/>
                    <Separator/>
                    <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="SaveDocument_Click"/>
                </MenuItem>
                <MenuItem Header="_Edit"/>
                <MenuItem Header="_Selection"/>
                <MenuItem Header="_View">
                    <MenuItem Header="Explorateur" InputGestureText="Ctrl+Shift+E" Tag="Explorer" Click="ViewMenu_Click"/>
                    <MenuItem Header="Recherche" InputGestureText="Ctrl+Shift+F" Tag="Search" Click="ViewMenu_Click"/>
                    <MenuItem Header="Contrôle de code source" InputGestureText="Ctrl+Shift+G" Tag="Source Control" Click="ViewMenu_Click"/>
                    <MenuItem Header="Assistant IA" InputGestureText="Ctrl+Shift+I" Tag="Assistant" Click="ViewMenu_Click"/>
                    <Separator/>
                    <MenuItem Header="Paramètres" InputGestureText="Ctrl+," Click="Settings_Click"/>
                </MenuItem>
                <MenuItem Header="_Run">
                    <MenuItem Header="Exécuter le fichier" InputGestureText="Ctrl+F5" Click="RunFile_Click"/>
                    <MenuItem Header="Déboguer le fichier" InputGestureText="F5" Click="DebugFile_Click"/>
                    <MenuItem Header="Arrêter" InputGestureText="Shift+F5" Click="StopRun_Click"/>
                </MenuItem>
                <MenuItem Header="_Terminal">
                    <MenuItem Header="Afficher le terminal" InputGestureText="Ctrl+Shift+T" Click="ShowTerminal_Click"/>
                    <MenuItem Header="Effacer le terminal" Click="ClearTerminal_Click"/>
                    <MenuItem Header="Redémarrer le terminal" Click="RestartTerminal_Click"/>
                </MenuItem>
                <MenuItem Header="_Help"/>
            </Menu>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="260" MinWidth="180" MaxWidth="500"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}">
                <DockPanel>
                <Button DockPanel.Dock="Bottom"
                        Style="{StaticResource ActivityButton}"
                        Tag="Settings"
                        ToolTip="Paramètres (Ctrl+,)"
                        Margin="0,0,0,6"
                        Click="Settings_Click">
                    <Viewbox Width="22" Height="22">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.55"
                                  StrokeLineJoin="Round"
                                  Data="M12,8.75 A3.25,3.25 0 1 1 12,15.25 A3.25,3.25 0 1 1 12,8.75 M12,2.5 L12,5 M12,19 L12,21.5 M4.2,4.2 L6.4,6.4 M17.6,17.6 L19.8,19.8 M2.5,12 L5,12 M19,12 L21.5,12 M4.2,19.8 L6.4,17.6 M17.6,6.4 L19.8,4.2"/>
                        </Canvas>
                    </Viewbox>
                </Button>
                <StackPanel x:Name="ActivityBar" HorizontalAlignment="Center" Margin="0,6">
                    <Button x:Name="ExplorerActivity"
                            Style="{StaticResource ActivityButton}"
                            Foreground="{DynamicResource AccentBrush}"
                            Tag="Explorer"
                            ToolTip="Explorer"
                            Click="ActivityButton_Click">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.55"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M3.5,6.5 L9.5,6.5 L11.5,8.5 L20.5,8.5 L20.5,19 L3.5,19 Z M3.5,10 L20.5,10"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource ActivityButton}"
                            Tag="Search"
                            ToolTip="Search"
                            Click="ActivityButton_Click">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Ellipse Width="12" Height="12"
                                         Canvas.Left="3" Canvas.Top="3"
                                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                         StrokeThickness="1.65"/>
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.65"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M13.2,13.2 L20,20"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource ActivityButton}"
                            Tag="Source Control"
                            ToolTip="Source Control"
                            Click="ActivityButton_Click">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Ellipse Width="5" Height="5" Canvas.Left="4.5" Canvas.Top="2"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <Ellipse Width="5" Height="5" Canvas.Left="14.5" Canvas.Top="2"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <Ellipse Width="5" Height="5" Canvas.Left="4.5" Canvas.Top="17"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.55"
                                      Data="M7,7 L7,17 M17,7 L17,10 C17,13.5 14.5,15 11.5,15 L7,15"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource ActivityButton}"
                            Tag="Assistant"
                            ToolTip="Assistant IA (Ctrl+Shift+I)"
                            Click="ActivityButton_Click">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.55"
                                      StrokeLineJoin="Round"
                                      Data="M4,5 L20,5 L20,16 L11,16 L7,20 L7,16 L4,16 Z M8,9.5 L16,9.5 M8,12.5 L13,12.5"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{DynamicResource SidebarBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="10,8,10,8">
                    <Grid x:Name="ExplorerPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="EXPLORER"
                                       Style="{StaticResource PanelTitle}"
                                       VerticalAlignment="Center"
                                       DockPanel.Dock="Left"/>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        DockPanel.Dock="Right">
                                <Button Style="{StaticResource ExplorerActionButton}"
                                        ToolTip="New File"
                                        Click="NewFile_Click">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="16" Height="16">
                                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1"
                                                  Data="M3,2 L10,2 L13,5 L13,14 L3,14 Z M10,2 L10,6 L13,6"/>
                                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1"
                                                  Data="M6.5,9.5 L11.5,9.5 M9,7 L9,12"/>
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Button Style="{StaticResource ExplorerActionButton}"
                                        ToolTip="New Folder"
                                        Click="NewFolder_Click">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="16" Height="16">
                                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1"
                                                  Data="M1.5,3.5 L6.5,3.5 L8,5.5 L14.5,5.5 L14.5,13 L1.5,13 Z"/>
                                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1"
                                                  Data="M8,7.5 L8,11.5 M6,9.5 L10,9.5"/>
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Button Style="{StaticResource ExplorerActionButton}"
                                        ToolTip="Refresh Explorer"
                                        Click="RefreshExplorer_Click">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="16" Height="16">
                                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1"
                                                  Data="M13.5,5.5 A6,6 0 1 0 13.5,10.5 M13.5,2.5 L13.5,5.5 L10.5,5.5"/>
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Button Style="{StaticResource ExplorerActionButton}"
                                        ToolTip="Collapse Folders"
                                        Click="CollapseFolders_Click">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="16" Height="16">
                                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1"
                                                  Data="M1.5,3 L8.5,3 M1.5,7 L8.5,7 M1.5,11 L8.5,11"/>
                                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1"
                                                  Data="M11,5 L13.5,7.5 L11,10"/>
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock x:Name="WorkspaceLabel" Grid.Row="1"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   Margin="0,0,0,8"/>
                        <TreeView x:Name="ExplorerTree" Grid.Row="2"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Foreground="{DynamicResource PrimaryText}"/>

                        <!-- Aucun dossier ouvert : comme dans VS Code -->
                        <StackPanel x:Name="NoFolderPanel" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed">
                            <TextBlock Text="AUCUN DOSSIER OUVERT" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <TextBlock Text="Tu n'as pas encore ouvert de dossier."
                                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}"/>
                            <Button Content="Ouvrir un dossier" Margin="0,14,0,0" Padding="0,7"
                                    HorizontalAlignment="Stretch" Cursor="Hand" Click="OpenFolder_Click"/>
                            <TextBlock Text="Ouvrir un dossier permet de voir ses fichiers ici, de les modifier et d'utiliser Git."
                                       TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="20"
                                       Foreground="{DynamicResource SecondaryText}"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="SearchPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="SEARCH"
                                   Style="{StaticResource PanelTitle}"
                                   Margin="0,0,0,10"/>
                        <DockPanel Grid.Row="1" Margin="0,0,0,8">
                            <Button Content="Find" Padding="8,3"
                                    Click="SearchButton_Click"
                                    DockPanel.Dock="Right"/>
                            <TextBox x:Name="SearchBox" Height="27"
                                     VerticalContentAlignment="Center"
                                     KeyDown="SearchBox_KeyDown"/>
                        </DockPanel>
                        <ListBox x:Name="SearchResults" Grid.Row="2"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource PrimaryText}"
                                 MouseDoubleClick="SearchResults_MouseDoubleClick"/>
                    </Grid>

                    <!-- Membre 5 : Git/GitHub et assistant IA (avec leurs propres styles) -->
                    <Grid Margin="-10,-8,-10,-8">
                        <Grid.Resources>
                            <ResourceDictionary Source="pack://application:,,,/KeycesCode.Settings;component/Themes/Controls.xaml"/>
                        </Grid.Resources>
                        <git:GitPanel x:Name="SourceControlPanel"
                                      Visibility="Collapsed"
                                      FolderOpened="SourceControlPanel_FolderOpened"
                                      BranchChanged="SourceControlPanel_BranchChanged"/>
                        <ai:AssistantPanel x:Name="AssistantView"
                                           Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="2"
                          Width="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource BorderBrush}"
                          ShowsPreview="False"/>

            <Grid Grid.Column="3" Background="{DynamicResource EditorBackground}">
                <TabControl x:Name="EditorTabs"
                            SelectionChanged="EditorTabs_SelectionChanged"
                            Background="{DynamicResource EditorBackground}"
                            BorderThickness="0"/>
                <!-- Page d'accueil (aucun fichier ouvert), inspirée de VS Code -->
                <ScrollViewer x:Name="WelcomePanel" VerticalScrollBarVisibility="Auto"
                              Background="{DynamicResource EditorBackground}">
                    <Grid Margin="90,70,50,40" MaxWidth="1000" HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="320"/>
                            <ColumnDefinition Width="*" MinWidth="320"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,40">
                            <TextBlock Text="Keyce'sCode" FontSize="34" Foreground="{DynamicResource PrimaryText}"/>
                            <TextBlock Text="Ton code. Ton environnement." FontSize="19" Margin="0,4,0,0"
                                       Foreground="{DynamicResource SecondaryText}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <TextBlock Text="Démarrer" FontSize="19" Margin="0,0,0,10"/>
                            <Button Style="{StaticResource WelcomeLink}" Click="WelcomeNewFile_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource LinkText}"/>
                                    <TextBlock Text="Nouveau fichier..." Foreground="{DynamicResource LinkText}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource WelcomeLink}" Click="WelcomeOpenFile_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource LinkText}"/>
                                    <TextBlock Text="Ouvrir un fichier..." Foreground="{DynamicResource LinkText}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource WelcomeLink}" Click="OpenFolder_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource LinkText}"/>
                                    <TextBlock Text="Ouvrir un dossier..." Foreground="{DynamicResource LinkText}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource WelcomeLink}" Click="WelcomeClone_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⎇" FontFamily="Segoe UI Symbol" Margin="1,0,11,0" VerticalAlignment="Center" Foreground="{DynamicResource LinkText}"/>
                                    <TextBlock Text="Cloner un dépôt Git..." Foreground="{DynamicResource LinkText}"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="Récents" FontSize="19" Margin="0,30,0,10"/>
                            <ItemsControl x:Name="RecentList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource WelcomeLink}" Tag="{Binding Path}"
                                                Click="RecentFolder_Click" ToolTip="{Binding Path}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource LinkText}"
                                                           Margin="0,0,14,0"/>
                                                <TextBlock Text="{Binding Path}" Foreground="{DynamicResource SecondaryText}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoRecentText" Text="Aucun dossier récent."
                                       Foreground="{DynamicResource SecondaryText}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="50,0,0,0">
                            <TextBlock Text="Découvrir" FontSize="19" Margin="0,0,0,10"/>
                            <Button Style="{StaticResource WelcomeCard}" Tag="Assistant" Click="WelcomeCard_Click">
                                <StackPanel>
                                    <TextBlock Text="Assistant IA local" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Pose des questions sur ton code. Tout reste sur ton PC (Ollama)."
                                               TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryText}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource WelcomeCard}" Tag="Source Control" Click="WelcomeCard_Click">
                                <StackPanel>
                                    <TextBlock Text="Git et GitHub" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Commit, push, pull et clonage sans quitter l'éditeur."
                                               TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryText}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource WelcomeCard}" Tag="Terminal" Click="WelcomeCard_Click">
                                <StackPanel>
                                    <TextBlock Text="Terminal et exécution" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="PowerShell intégré, Ctrl+F5 pour exécuter le fichier ouvert."
                                               TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryText}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource WelcomeCard}" Tag="Settings" Click="WelcomeCard_Click">
                                <StackPanel>
                                    <TextBlock Text="Personnaliser Keyce'sCode" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Thème clair ou sombre, police, raccourcis, enregistrement automatique."
                                               TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryText}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Membre 5 : la page Paramètres s'ouvre par-dessus l'éditeur -->
                <Grid x:Name="SettingsHost" Visibility="Collapsed">
                    <Grid.Resources>
                        <ResourceDictionary Source="pack://application:,,,/KeycesCode.Settings;component/Themes/Controls.xaml"/>
                    </Grid.Resources>
                    <set:SettingsPage x:Name="SettingsEditor"/>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="3"
                Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel Margin="15">
                <StackPanel x:Name="BottomPanelTabs"
                            DockPanel.Dock="Top"
                            Orientation="Horizontal"
                            Margin="0,0,0,12">
                    <Button x:Name="ProblemsTab"
                            Content="PROBLEMS"
                            Style="{StaticResource BottomPanelTab}"
                            Tag="Problems"
                            Click="BottomPanelTab_Click"/>
                    <Button x:Name="OutputTab"
                            Content="OUTPUT"
                            Style="{StaticResource BottomPanelTab}"
                            Tag="Output"
                            Click="BottomPanelTab_Click"/>
                    <Button x:Name="DebugConsoleTab"
                            Content="DEBUG CONSOLE"
                            Style="{StaticResource BottomPanelTab}"
                            Tag="Debug Console"
                            Click="BottomPanelTab_Click"/>
                    <Button x:Name="TerminalTab"
                            Content="TERMINAL"
                            Style="{StaticResource BottomPanelTab}"
                            Tag="Terminal"
                            Foreground="{DynamicResource AccentBrush}"
                            Click="BottomPanelTab_Click"/>
                </StackPanel>
                <Grid>
                    <TextBox x:Name="ProblemsContent"
                             Text="No problems detected."
                             IsReadOnly="True"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource SecondaryText}"
                             FontFamily="Consolas"
                             FontSize="12"
                             Visibility="Collapsed"/>
                    <TextBox x:Name="OutputContent"
                             Text="No output to display."
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             IsReadOnly="True"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource SecondaryText}"
                             FontFamily="Consolas"
                             FontSize="12"
                             Visibility="Collapsed"/>
                    <TextBox x:Name="DebugConsoleContent"
                             Text="Debug console is ready."
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             IsReadOnly="True"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource SecondaryText}"
                             FontFamily="Consolas"
                             FontSize="12"
                             Visibility="Collapsed"/>
                    <!-- Terminal (Membre 4) : sortie en haut, commande en bas -->
                    <DockPanel x:Name="TerminalContent">
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                            <TextBlock Text="PS &gt;" DockPanel.Dock="Left" Margin="0,0,6,0"
                                       VerticalAlignment="Center" FontFamily="Consolas" FontSize="12"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBox x:Name="TerminalInput"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     PreviewKeyDown="TerminalInput_PreviewKeyDown"/>
                        </DockPanel>
                        <TextBox x:Name="TerminalOutput"
                                 IsReadOnly="True"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource SecondaryText}"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"/>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Border>

        <Border Grid.Row="4" Background="{DynamicResource StatusBarBackground}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="10,0">
                <DockPanel.Resources>
                    <!-- Texte de la barre d'état : lisible sur le fond bleu -->
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource StatusBarText}"/>
                    </Style>
                </DockPanel.Resources>
                <TextBlock x:Name="BranchStatus"
                           VerticalAlignment="Center" FontSize="10"
                           Margin="0,0,14,0"/>
                <TextBlock x:Name="StatusText" Text="Ready"
                           VerticalAlignment="Center" FontSize="10"/>
                <TextBlock Text="KEYCE CODE"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="10"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
