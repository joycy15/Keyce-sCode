<Window x:Class="KeycesCode.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:git="clr-namespace:KeycesCode.Settings.Git;assembly=KeycesCode.Settings"
        xmlns:set="clr-namespace:KeycesCode.Settings;assembly=KeycesCode.Settings"
        xmlns:ai="clr-namespace:KeycesCode.Assistant;assembly=KeycesCode.Assistant"
        Title="Keyce'sCode"
        Icon="/Assets/keycescode.ico"
        Height="850"
        Width="1450"
        MinHeight="600"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource PrimaryText}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- Barre de titre personnalisée comme VS Code : logo + menus + titre au centre + boutons Windows -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Page d'accueil : liens comme dans VS Code -->
        <Style x:Key="WelcomeLink" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource LinkText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" Padding="0,3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WelcomeCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource SidebarBackground}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="16,12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Onglets du panneau du bas : PROBLEMS, OUTPUT, TERMINAL, DEBUG CONSOLE (soulignés quand actifs) -->
        <Style x:Key="BottomPanelTab" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PanelTabText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,8,0,6"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="TabUnderline" Height="1" VerticalAlignment="Bottom"
                                    Background="{DynamicResource PanelTabActive}" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PanelTabActive}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Petits boutons d'action (explorateur, panneau du bas) -->
        <Style x:Key="ExplorerActionButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowDuration" Value="10000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="Transparent" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ToolbarHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icônes de la barre d'activité (à gauche) : grises, blanches + trait blanc quand actives -->
        <Style x:Key="ActivityButton" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ActivityBarInactive}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowDuration" Value="10000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="ActiveIndicator" Width="2" HorizontalAlignment="Left"
                                    Background="{DynamicResource ActivityBarIndicator}" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ActivityBarForeground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActivityButtonActive" TargetType="Button" BasedOn="{StaticResource ActivityButton}">
            <Setter Property="Foreground" Value="{DynamicResource ActivityBarForeground}"/>
        </Style>
        <Style x:Key="BottomPanelTabActive" TargetType="Button" BasedOn="{StaticResource BottomPanelTab}">
            <Setter Property="Foreground" Value="{DynamicResource PanelTabActive}"/>
        </Style>
    </Window.Resources>

    <!-- RootBorder : quand la fenêtre est agrandie, on ajoute une marge pour ne pas déborder de l'écran -->
    <Border x:Name="RootBorder" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="22"/>
            </Grid.RowDefinitions>

            <!-- ===================== Barre de titre ===================== -->
            <Grid Grid.Row="0" Background="{DynamicResource TitleBarBackground}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Titre au centre : « fichier — dossier — Keyce'sCode » -->
                <TextBlock x:Name="TitleText" Grid.ColumnSpan="3"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="12" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TitleBarText}"/>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Image Source="/Assets/logo.png" Width="16" Height="16" Margin="10,0,6,0"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Menu Background="Transparent" VerticalAlignment="Center" FontSize="13"
                          Foreground="{DynamicResource TitleBarText}"
                          WindowChrome.IsHitTestVisibleInChrome="True">
                        <MenuItem Header="_File">
                            <MenuItem Header="Nouveau fichier..." InputGestureText="Ctrl+N" Click="WelcomeNewFile_Click"/>
                            <MenuItem Header="Ouvrir un fichier..." InputGestureText="Ctrl+O" Click="WelcomeOpenFile_Click"/>
                            <MenuItem Header="Ouvrir un dossier..." InputGestureText="Ctrl+K Ctrl+O" Click="OpenFolder_Click"/>
                            <Separator/>
                            <MenuItem Header="Enregistrer" InputGestureText="Ctrl+S" Click="SaveDocument_Click"/>
                            <MenuItem Header="Tout enregistrer" Click="SaveAll_Click"/>
                            <Separator/>
                            <MenuItem Header="Fermer l'éditeur" InputGestureText="Ctrl+W" Click="CloseEditor_Click"/>
                            <MenuItem Header="Fermer le dossier" Click="CloseFolder_Click"/>
                            <Separator/>
                            <MenuItem Header="Paramètres" InputGestureText="Ctrl+," Click="Settings_Click"/>
                            <Separator/>
                            <MenuItem Header="Quitter" Click="CloseWindow_Click"/>
                        </MenuItem>
                        <MenuItem Header="_Edit">
                            <MenuItem Header="Annuler" InputGestureText="Ctrl+Z" Command="ApplicationCommands.Undo"/>
                            <MenuItem Header="Rétablir" InputGestureText="Ctrl+Y" Command="ApplicationCommands.Redo"/>
                            <Separator/>
                            <MenuItem Header="Couper" InputGestureText="Ctrl+X" Command="ApplicationCommands.Cut"/>
                            <MenuItem Header="Copier" InputGestureText="Ctrl+C" Command="ApplicationCommands.Copy"/>
                            <MenuItem Header="Coller" InputGestureText="Ctrl+V" Command="ApplicationCommands.Paste"/>
                        </MenuItem>
                        <MenuItem Header="_Selection">
                            <MenuItem Header="Tout sélectionner" InputGestureText="Ctrl+A" Command="ApplicationCommands.SelectAll"/>
                        </MenuItem>
                        <MenuItem Header="_View">
                            <MenuItem Header="Explorateur" InputGestureText="Ctrl+Shift+E" Tag="Explorer" Click="ViewMenu_Click"/>
                            <MenuItem Header="Recherche" InputGestureText="Ctrl+Shift+F" Tag="Search" Click="ViewMenu_Click"/>
                            <MenuItem Header="Contrôle de code source" InputGestureText="Ctrl+Shift+G" Tag="Source Control" Click="ViewMenu_Click"/>
                            <MenuItem Header="Assistant IA" InputGestureText="Ctrl+Shift+I" Tag="Assistant" Click="ViewMenu_Click"/>
                            <Separator/>
                            <MenuItem Header="Barre latérale" InputGestureText="Ctrl+B" Click="ToggleSidebar_Click"/>
                            <MenuItem Header="Panneau du bas" InputGestureText="Ctrl+J" Click="TogglePanel_Click"/>
                        </MenuItem>
                        <MenuItem Header="_Run">
                            <MenuItem Header="Exécuter le fichier" InputGestureText="Ctrl+F5" Click="RunFile_Click"/>
                            <MenuItem Header="Déboguer le fichier" InputGestureText="F5" Click="DebugFile_Click"/>
                            <MenuItem Header="Arrêter" InputGestureText="Shift+F5" Click="StopRun_Click"/>
                        </MenuItem>
                        <MenuItem Header="_Terminal">
                            <MenuItem Header="Afficher le terminal" InputGestureText="Ctrl+Shift+T" Click="ShowTerminal_Click"/>
                            <MenuItem Header="Effacer le terminal" Click="ClearTerminal_Click"/>
                            <MenuItem Header="Redémarrer le terminal" Click="RestartTerminal_Click"/>
                        </MenuItem>
                        <MenuItem Header="_Help">
                            <MenuItem Header="À propos de Keyce'sCode" Click="About_Click"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Réduire"
                            Click="MinimizeWindow_Click"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE923;"
                            ToolTip="Restaurer" Click="MaximizeWindow_Click"/>
                    <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" ToolTip="Fermer"
                            Click="CloseWindow_Click"/>
                </StackPanel>
            </Grid>

            <!-- ===================== Barre d'activité + barre latérale + éditeur ===================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition x:Name="SidebarColumn" Width="280" MinWidth="170" MaxWidth="600"/>
                    <ColumnDefinition x:Name="SplitterColumn" Width="4"/>
                    <ColumnDefinition Width="*" MinWidth="300"/>
                    <ColumnDefinition x:Name="ChatSplitterColumn" Width="0"/>
                    <ColumnDefinition x:Name="ChatColumn" Width="0" MaxWidth="800"/>
                </Grid.ColumnDefinitions>

                <!-- Barre d'activité -->
                <Border Grid.Column="0" Background="{DynamicResource ActivityBarBackground}">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom"
                                Style="{StaticResource ActivityButton}"
                                ToolTip="Paramètres (Ctrl+,)"
                                Margin="0,0,0,4"
                                Click="Settings_Click">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="22"/>
                        </Button>
                        <StackPanel x:Name="ActivityBar">
                            <Button x:Name="ExplorerActivity"
                                    Style="{StaticResource ActivityButton}"
                                    Tag="Explorer"
                                    ToolTip="Explorateur (Ctrl+Shift+E)"
                                    Click="ActivityButton_Click">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="23"/>
                            </Button>
                            <Button Style="{StaticResource ActivityButton}"
                                    Tag="Search"
                                    ToolTip="Recherche (Ctrl+Shift+F)"
                                    Click="ActivityButton_Click">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="22"/>
                            </Button>
                            <Button Style="{StaticResource ActivityButton}"
                                    Tag="Source Control"
                                    ToolTip="Contrôle de code source (Ctrl+Shift+G)"
                                    Click="ActivityButton_Click">
                                <Viewbox Width="24" Height="24">
                                    <Canvas Width="24" Height="24">
                                        <Ellipse Width="5" Height="5" Canvas.Left="4.5" Canvas.Top="2"
                                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/>
                                        <Ellipse Width="5" Height="5" Canvas.Left="14.5" Canvas.Top="6"
                                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/>
                                        <Ellipse Width="5" Height="5" Canvas.Left="4.5" Canvas.Top="17"
                                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/>
                                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5"
                                              Data="M7,7 L7,17 M17,11 C17,14 14,15 11,15 L7,15"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button Style="{StaticResource ActivityButton}"
                                    Tag="Assistant"
                                    ToolTip="Assistant IA (Ctrl+Shift+I)"
                                    Click="ActivityButton_Click">
                                <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="22"/>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Barre latérale -->
                <Border x:Name="SidebarHost" Grid.Column="1" Background="{DynamicResource SidebarBackground}">
                    <Grid>
                        <Grid x:Name="ExplorerPanel">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="20,0,8,0">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource ExplorerActionButton}" ToolTip="Nouveau fichier"
                                            Click="NewFile_Click">
                                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                    </Button>
                                    <Button Style="{StaticResource ExplorerActionButton}" ToolTip="Nouveau dossier"
                                            Click="NewFolder_Click">
                                        <TextBlock Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                    </Button>
                                    <Button Style="{StaticResource ExplorerActionButton}" ToolTip="Actualiser l'explorateur"
                                            Click="RefreshExplorer_Click">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                    </Button>
                                    <Button Style="{StaticResource ExplorerActionButton}" ToolTip="Réduire les dossiers"
                                            Click="CollapseFolders_Click">
                                        <TextBlock Text="&#xE8C4;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="EXPLORER" Style="{StaticResource PanelTitle}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="WorkspaceLabel" Grid.Row="1" Visibility="Collapsed"/>
                            <TreeView x:Name="ExplorerTree" Grid.Row="2"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Foreground="{DynamicResource PrimaryText}"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

                            <!-- Aucun dossier ouvert : comme dans VS Code -->
                            <StackPanel x:Name="NoFolderPanel" Grid.Row="1" Grid.RowSpan="2" Margin="20,4,20,0"
                                        Visibility="Collapsed">
                                <TextBlock Text="Tu n'as pas encore ouvert de dossier."
                                           TextWrapping="Wrap" Foreground="{DynamicResource PrimaryText}"/>
                                <Button Content="Ouvrir un dossier" Margin="0,14,0,0" Padding="0,6"
                                        HorizontalAlignment="Stretch" Cursor="Hand" Click="OpenFolder_Click"/>
                                <TextBlock Text="Ouvrir un dossier permet de voir ses fichiers ici, de les modifier et d'utiliser Git."
                                           TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="20"
                                           Foreground="{DynamicResource PrimaryText}"/>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="SearchPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="SEARCH" Style="{StaticResource PanelTitle}"
                                       Margin="20,0,0,0" VerticalAlignment="Center"/>
                            <Grid Grid.Row="1" Margin="20,0,12,8">
                                <TextBox x:Name="SearchBox" Height="26" Padding="6,3,28,3"
                                         VerticalContentAlignment="Center"
                                         BorderBrush="{DynamicResource InputBackground}"
                                         KeyDown="SearchBox_KeyDown"/>
                                <Button Style="{StaticResource ExplorerActionButton}" HorizontalAlignment="Right"
                                        Margin="0,0,3,0" ToolTip="Rechercher (Entrée)" Click="SearchButton_Click">
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                </Button>
                            </Grid>
                            <ListBox x:Name="SearchResults" Grid.Row="2"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource PrimaryText}"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     MouseDoubleClick="SearchResults_MouseDoubleClick"/>
                        </Grid>

                        <!-- Membre 5 : Git/GitHub (avec ses propres styles) -->
                        <Grid>
                            <Grid.Resources>
                                <ResourceDictionary Source="pack://application:,,,/KeycesCode.Settings;component/Themes/Controls.xaml"/>
                            </Grid.Resources>
                            <git:GitPanel x:Name="SourceControlPanel"
                                          Visibility="Collapsed"
                                          FolderOpened="SourceControlPanel_FolderOpened"
                                          BranchChanged="SourceControlPanel_BranchChanged"/>
                        </Grid>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="2"
                              Width="4"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"
                              Background="{DynamicResource EditorBackground}"
                              Focusable="False"
                              ShowsPreview="False"/>

                <!-- Éditeur + panneau du bas (comme VS Code : le terminal reste sous l'éditeur, pas sous l'explorateur) -->
                <Grid Grid.Column="3">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="EditorRow" Height="*" MinHeight="80"/>
                        <RowDefinition x:Name="BottomPanelRow" Height="250" MinHeight="90"/>
                    </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="{DynamicResource EditorBackground}">
                    <TabControl x:Name="EditorTabs"
                                SelectionChanged="EditorTabs_SelectionChanged"/>

                    <!-- Page d'accueil (aucun fichier ouvert), inspirée de VS Code -->
                    <ScrollViewer x:Name="WelcomePanel" VerticalScrollBarVisibility="Auto"
                                  Background="{DynamicResource EditorBackground}">
                        <Grid Margin="90,70,50,40" MaxWidth="1000" HorizontalAlignment="Left">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="320"/>
                                <ColumnDefinition Width="*" MinWidth="320"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,40">
                                <Image Source="/Assets/logo.png" Width="72" Height="72" Margin="0,0,20,0"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Keyce'sCode" FontSize="34" FontWeight="Light"
                                               Foreground="{DynamicResource PrimaryText}"/>
                                    <TextBlock Text="Ton code. Ton environnement." FontSize="17" Margin="0,2,0,0"
                                               Foreground="{DynamicResource SecondaryText}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Row="1">
                                <TextBlock Text="Démarrer" FontSize="17" Margin="0,0,0,10"/>
                                <Button Style="{StaticResource WelcomeLink}" Click="WelcomeNewFile_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource LinkText}"/>
                                        <TextBlock Text="Nouveau fichier..." Foreground="{DynamicResource LinkText}"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource WelcomeLink}" Click="WelcomeOpenFile_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource LinkText}"/>
                                        <TextBlock Text="Ouvrir un fichier..." Foreground="{DynamicResource LinkText}"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource WelcomeLink}" Click="OpenFolder_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource LinkText}"/>
                                        <TextBlock Text="Ouvrir un dossier..." Foreground="{DynamicResource LinkText}"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource WelcomeLink}" Click="WelcomeClone_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⎇" FontFamily="Segoe UI Symbol" Margin="1,0,11,0" VerticalAlignment="Center" Foreground="{DynamicResource LinkText}"/>
                                        <TextBlock Text="Cloner un dépôt Git..." Foreground="{DynamicResource LinkText}"/>
                                    </StackPanel>
                                </Button>

                                <TextBlock Text="Récents" FontSize="17" Margin="0,30,0,10"/>
                                <ItemsControl x:Name="RecentList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource WelcomeLink}" Tag="{Binding Path}"
                                                    Click="RecentFolder_Click" ToolTip="{Binding Path}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource LinkText}"
                                                               Margin="0,0,14,0"/>
                                                    <TextBlock Text="{Binding Path}" Foreground="{DynamicResource SecondaryText}"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="NoRecentText" Text="Aucun dossier récent."
                                           Foreground="{DynamicResource SecondaryText}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="50,0,0,0">
                                <TextBlock Text="Découvrir" FontSize="17" Margin="0,0,0,10"/>
                                <Button Style="{StaticResource WelcomeCard}" Tag="Assistant" Click="WelcomeCard_Click">
                                    <StackPanel>
                                        <TextBlock Text="Assistant IA (Gemini)" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="Pose des questions sur ton code : l'assistant (Google Gemini) voit ton fichier et écrit directement dans l'éditeur."
                                                   TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryText}"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource WelcomeCard}" Tag="Source Control" Click="WelcomeCard_Click">
                                    <StackPanel>
                                        <TextBlock Text="Git et GitHub" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="Commit, push, pull et clonage sans quitter l'éditeur."
                                                   TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryText}"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource WelcomeCard}" Tag="Terminal" Click="WelcomeCard_Click">
                                    <StackPanel>
                                        <TextBlock Text="Terminal et exécution" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="PowerShell intégré, Ctrl+F5 pour exécuter le fichier ouvert."
                                                   TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryText}"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource WelcomeCard}" Tag="Settings" Click="WelcomeCard_Click">
                                    <StackPanel>
                                        <TextBlock Text="Personnaliser Keyce'sCode" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="Thème clair ou sombre, police, raccourcis, enregistrement automatique."
                                                   TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryText}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- Membre 5 : la page Paramètres s'ouvre par-dessus l'éditeur -->
                    <Grid x:Name="SettingsHost" Visibility="Collapsed">
                        <Grid.Resources>
                            <ResourceDictionary Source="pack://application:,,,/KeycesCode.Settings;component/Themes/Controls.xaml"/>
                        </Grid.Resources>
                        <set:SettingsPage x:Name="SettingsEditor"/>
                    </Grid>
                </Grid>

                    <!-- Poignée pour redimensionner le panneau du bas (on la tire vers le haut ou le bas) -->
                    <GridSplitter Grid.Row="1" Height="4" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                  ResizeDirection="Rows" ResizeBehavior="PreviousAndCurrent"
                                  Background="Transparent" Focusable="False" Panel.ZIndex="10"/>

                    <!-- ===================== Panneau du bas ===================== -->
                    <Border x:Name="BottomPanel" Grid.Row="1"
                            Background="{DynamicResource PanelBackground}"
                            BorderBrush="{DynamicResource PanelBorder}"
                            BorderThickness="0,1,0,0">
                        <DockPanel>
                            <!-- Barre du panneau : onglets à gauche, actions à droite (comme VS Code) -->
                            <DockPanel DockPanel.Dock="Top" Height="35" Margin="8,0,8,0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Choix du shell (comme le menu « powershell ▾ » de VS Code) -->
                                    <StackPanel x:Name="ShellLabel" Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Button x:Name="ShellButton" Style="{StaticResource ExplorerActionButton}" Width="Auto"
                                                ToolTip="Choisir le terminal : PowerShell ou Invite de commandes (cmd)"
                                                Click="ShellButton_Click">
                                            <StackPanel Orientation="Horizontal" Margin="6,0">
                                                <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock x:Name="ShellName" Text="powershell" VerticalAlignment="Center" FontSize="12"/>
                                                <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                                           VerticalAlignment="Center" Margin="6,1,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <Button Style="{StaticResource ExplorerActionButton}" ToolTip="Nouveau terminal (redémarrer)"
                                            Click="RestartTerminal_Click">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </Button>
                                    <Button Style="{StaticResource ExplorerActionButton}" ToolTip="Effacer"
                                            Click="ClearPanel_Click">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </Button>
                                    <Button x:Name="MaximizePanelButton" Style="{StaticResource ExplorerActionButton}"
                                            ToolTip="Agrandir le panneau" Click="MaximizePanel_Click">
                                        <TextBlock x:Name="MaximizePanelIcon" Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </Button>
                                    <Button Style="{StaticResource ExplorerActionButton}" ToolTip="Masquer le panneau (Ctrl+J)"
                                            Click="HidePanel_Click">
                                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                                    </Button>
                                </StackPanel>
                                <StackPanel x:Name="BottomPanelTabs" Orientation="Horizontal">
                                    <Button x:Name="ProblemsTab" Content="PROBLEMS" Style="{StaticResource BottomPanelTab}"
                                            Tag="Problems" Click="BottomPanelTab_Click"/>
                                    <Button x:Name="OutputTab" Content="OUTPUT" Style="{StaticResource BottomPanelTab}"
                                            Tag="Output" Click="BottomPanelTab_Click"/>
                                    <Button x:Name="TerminalTab" Content="TERMINAL" Style="{StaticResource BottomPanelTab}"
                                            Tag="Terminal" Click="BottomPanelTab_Click"/>
                                    <Button x:Name="DebugConsoleTab" Content="DEBUG CONSOLE" Style="{StaticResource BottomPanelTab}"
                                            Tag="Debug Console" Click="BottomPanelTab_Click"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Saisie pour le programme en cours (Console.ReadLine, input()...) -->
                            <DockPanel x:Name="RunInputBar" DockPanel.Dock="Bottom" Margin="20,6,8,6" Visibility="Collapsed">
                                <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11" DockPanel.Dock="Left"
                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource TerminalCommand}"/>
                                <Grid>
                                    <TextBox x:Name="RunInput"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="0"
                                             FontFamily="Cascadia Mono, Consolas, Courier New"
                                             FontSize="13"
                                             Foreground="{DynamicResource TerminalCommand}"
                                             CaretBrush="{DynamicResource PrimaryText}"
                                             PreviewKeyDown="RunInput_PreviewKeyDown"/>
                                    <TextBlock Text="Le programme attend une saisie ? Tape ici puis Entrée"
                                               IsHitTestVisible="False" VerticalAlignment="Center"
                                               FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="13"
                                               Foreground="{DynamicResource MutedText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text.IsEmpty, ElementName=RunInput}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DockPanel>

                            <Grid Margin="20,0,8,4">
                                <TextBox x:Name="ProblemsContent"
                                         Text="Aucun problème détecté dans l'espace de travail."
                                         IsReadOnly="True"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource PrimaryText}"
                                         FontSize="13"
                                         Visibility="Collapsed"/>
                                <RichTextBox x:Name="OutputContent"
                                             IsReadOnly="True"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             FontFamily="Cascadia Mono, Consolas, Courier New"
                                             FontSize="13"
                                             VerticalScrollBarVisibility="Auto"
                                             IsUndoEnabled="False"
                                             Visibility="Collapsed"/>
                                <RichTextBox x:Name="DebugConsoleContent"
                                             IsReadOnly="True"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             FontFamily="Cascadia Mono, Consolas, Courier New"
                                             FontSize="13"
                                             VerticalScrollBarVisibility="Auto"
                                             IsUndoEnabled="False"
                                             Visibility="Collapsed"/>
                                <!-- Terminal (Membre 4) : la sortie puis la ligne de commande, qui défilent ensemble -->
                                <ScrollViewer x:Name="TerminalContent" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              PreviewMouseLeftButtonUp="TerminalArea_MouseUp">
                                    <StackPanel>
                                        <RichTextBox x:Name="TerminalOutput"
                                                     IsReadOnly="True"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Padding="0"
                                                     FontFamily="Cascadia Mono, Consolas, Courier New"
                                                     FontSize="13"
                                                     IsUndoEnabled="False"
                                                     VerticalScrollBarVisibility="Disabled"/>
                                        <DockPanel Margin="4,0,0,0">
                                            <TextBlock x:Name="TerminalPrompt" Text="PS &gt; " DockPanel.Dock="Left"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="13"
                                                       Foreground="{DynamicResource PrimaryText}"/>
                                            <TextBox x:Name="TerminalInput"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Padding="0"
                                                     FontFamily="Cascadia Mono, Consolas, Courier New"
                                                     FontSize="13"
                                                     Foreground="{DynamicResource TerminalCommand}"
                                                     CaretBrush="{DynamicResource PrimaryText}"
                                                     PreviewKeyDown="TerminalInput_PreviewKeyDown"/>
                                        </DockPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Chat de l'assistant IA à droite (comme le « Chat » de VS Code), sur toute la hauteur -->
                <GridSplitter Grid.Column="4"
                              Width="4"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"
                              Background="{DynamicResource PanelBorder}"
                              Focusable="False"
                              ShowsPreview="False"/>
                <Border x:Name="ChatHost" Grid.Column="5" Visibility="Collapsed"
                        Background="{DynamicResource SidebarBackground}">
                    <Border.Resources>
                        <ResourceDictionary Source="pack://application:,,,/KeycesCode.Settings;component/Themes/Controls.xaml"/>
                    </Border.Resources>
                    <ai:AssistantPanel x:Name="AssistantView"/>
                </Border>
            </Grid>

            <!-- ===================== Barre d'état bleue ===================== -->
            <Border Grid.Row="2" Background="{DynamicResource StatusBarBackground}">
                <DockPanel>
                    <DockPanel.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource StatusBarText}"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DockPanel.Resources>

                    <!-- Gauche : logo vert, branche Git, erreurs / avertissements, message -->
                    <Button DockPanel.Dock="Left" Style="{StaticResource StatusBarItem}" Padding="9,0"
                            Background="{DynamicResource StatusBarRemote}" ToolTip="Keyce'sCode"
                            Click="About_Click">
                        <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                    <Button DockPanel.Dock="Left" Style="{StaticResource StatusBarItem}" Margin="4,0,0,0"
                            ToolTip="Contrôle de code source" Click="BranchStatus_Click">
                        <TextBlock x:Name="BranchStatus" Text=""/>
                    </Button>
                    <Button DockPanel.Dock="Left" Style="{StaticResource StatusBarItem}"
                            ToolTip="Problèmes" Click="ProblemsStatus_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA39;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,4,0"/>
                            <TextBlock Text="0" Margin="0,0,8,0"/>
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,4,0"/>
                            <TextBlock Text="0"/>
                        </StackPanel>
                    </Button>

                    <!-- Droite : position du curseur, indentation, encodage, fin de ligne, langage, chat, notifications -->
                    <Button DockPanel.Dock="Right" Style="{StaticResource StatusBarItem}" Margin="0,0,6,0"
                            ToolTip="Notifications">
                        <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource StatusBarItem}"
                            ToolTip="Ouvrir / fermer le chat Gemini (Ctrl+Shift+I)" Click="ChatStatus_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0"/>
                            <TextBlock Text="Gemini"/>
                        </StackPanel>
                    </Button>
                    <StackPanel x:Name="EditorStatus" DockPanel.Dock="Right" Orientation="Horizontal"
                                Visibility="Collapsed">
                        <Button Style="{StaticResource StatusBarItem}" ToolTip="Aller à la ligne">
                            <TextBlock x:Name="CursorStatus" Text="Ln 1, Col 1"/>
                        </Button>
                        <Button Style="{StaticResource StatusBarItem}" ToolTip="Indentation">
                            <TextBlock x:Name="IndentStatus" Text="Spaces: 4"/>
                        </Button>
                        <Button Style="{StaticResource StatusBarItem}" ToolTip="Encodage">
                            <TextBlock Text="UTF-8"/>
                        </Button>
                        <Button Style="{StaticResource StatusBarItem}" ToolTip="Fin de ligne">
                            <TextBlock x:Name="EolStatus" Text="CRLF"/>
                        </Button>
                        <Button Style="{StaticResource StatusBarItem}" ToolTip="Langage du fichier">
                            <TextBlock x:Name="LanguageStatus" Text="Plain Text"/>
                        </Button>
                    </StackPanel>

                    <TextBlock x:Name="StatusText" Text="Prêt" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
