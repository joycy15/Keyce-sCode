<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>KeycesCode.App</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- Logo de Keyce'sCode : icône du .exe, de la barre des tâches et du raccourci -->
    <ApplicationIcon>Assets\keycescode.ico</ApplicationIcon>
    <Product>Keyce'sCode</Product>
    <AssemblyTitle>Keyce'sCode</AssemblyTitle>
    <Version>1.0.0</Version>

    <!-- Rapidité : optimise le code le plus utilisé pendant que l'application tourne -->
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- Images intégrées dans l'application (fenêtre, page d'accueil) -->
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\keycescode.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KeycesCode.Core\KeycesCode.Core.csproj" />
    <ProjectReference Include="..\KeycesCode.Settings\KeycesCode.Settings.csproj" />
    <ProjectReference Include="..\KeycesCode.Assistant\KeycesCode.Assistant.csproj" />
    <ProjectReference Include="..\KeycesCode.Execution\KeycesCode.Execution.csproj" />
    <ProjectReference Include="..\KeycesCode.Languages\KeycesCode.Languages.csproj" />
  </ItemGroup>

</Project>
