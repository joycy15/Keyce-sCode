<Window x:Class="Keyce_code.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KEYCE CODE"
        Height="850"
        Width="1450"
        MinHeight="600"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="BottomPanelTab" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="TabSurface"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="TabUnderline"
                                    Height="1"
                                    VerticalAlignment="Bottom"
                                    Background="Transparent"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="TabUnderline" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ExplorerActionButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowDuration" Value="10000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="Transparent"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource HoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource SelectedBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActivityButton" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="ToolTipService.ShowDuration" Value="10000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="HoverFill"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"/>
                            <Border x:Name="ActiveIndicator"
                                    Width="2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    Background="{TemplateBinding Foreground}"
                                    Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverFill" Property="Background" Value="{StaticResource HoverBackground}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverFill" Property="Background" Value="{StaticResource SelectedBackground}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="22"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource TitleBarBackground}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="12,0">
                <Border Width="16"
                        Height="16"
                        CornerRadius="3"
                        Background="{StaticResource AccentBrush}"
                        VerticalAlignment="Center"
                        Margin="0,0,9,0">
                    <TextBlock Text="K"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="KEYCE CODE"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource PrimaryText}"/>
                <TextBlock Text="— Development Environment"
                           Foreground="{StaticResource SecondaryText}"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource SidebarBackground}">
            <Menu Background="Transparent" Foreground="{StaticResource PrimaryText}">
                <MenuItem Header="_File">
                    <MenuItem Header="_Open Folder..." Click="OpenFolder_Click"/>
                    <Separator/>
                    <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="SaveDocument_Click"/>
                </MenuItem>
                <MenuItem Header="_Edit"/>
                <MenuItem Header="_Selection"/>
                <MenuItem Header="_View"/>
                <MenuItem Header="_Run"/>
                <MenuItem Header="_Terminal"/>
                <MenuItem Header="_Help"/>
            </Menu>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="260" MinWidth="180" MaxWidth="500"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SidebarBackground}">
                <DockPanel>
                <Button DockPanel.Dock="Bottom"
                        Style="{StaticResource ActivityButton}"
                        Tag="Settings"
                        ToolTip="Manage"
                        Margin="0,0,0,6"
                        IsEnabled="False">
                    <Viewbox Width="22" Height="22">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.55"
                                  StrokeLineJoin="Round"
                                  Data="M12,8.75 A3.25,3.25 0 1 1 12,15.25 A3.25,3.25 0 1 1 12,8.75 M12,2.5 L12,5 M12,19 L12,21.5 M4.2,4.2 L6.4,6.4 M17.6,17.6 L19.8,19.8 M2.5,12 L5,12 M19,12 L21.5,12 M4.2,19.8 L6.4,17.6 M17.6,6.4 L19.8,4.2"/>
                        </Canvas>
                    </Viewbox>
                </Button>
                <StackPanel x:Name="ActivityBar" HorizontalAlignment="Center" Margin="0,6">
                    <Button x:Name="ExplorerActivity"
                            Style="{StaticResource ActivityButton}"
                            Foreground="{StaticResource AccentBrush}"
                            Tag="Explorer"
                            ToolTip="Explorer"
                            Click="ActivityButton_Click">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.55"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M3.5,6.5 L9.5,6.5 L11.5,8.5 L20.5,8.5 L20.5,19 L3.5,19 Z M3.5,10 L20.5,10"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource ActivityButton}"
                            Tag="Search"
                            ToolTip="Search"
                            Click="ActivityButton_Click">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Ellipse Width="12" Height="12"
                                         Canvas.Left="3" Canvas.Top="3"
                                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                         StrokeThickness="1.65"/>
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.65"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M13.2,13.2 L20,20"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource ActivityButton}"
                            Tag="Source Control"
                            ToolTip="Source Control"
                            Click="ActivityButton_Click">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Ellipse Width="5" Height="5" Canvas.Left="4.5" Canvas.Top="2"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <Ellipse Width="5" Height="5" Canvas.Left="14.5" Canvas.Top="2"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <Ellipse Width="5" Height="5" Canvas.Left="4.5" Canvas.Top="17"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.55"
                                      Data="M7,7 L7,17 M17,7 L17,10 C17,13.5 14.5,15 11.5,15 L7,15"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource ActivityButton}"
                            Tag="Extensions"
                            ToolTip="Extensions"
                            Click="ActivityButton_Click">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Rectangle Width="7" Height="7" Canvas.Left="3" Canvas.Top="3"
                                           RadiusX="1" RadiusY="1"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           StrokeThickness="1.45"/>
                                <Rectangle Width="7" Height="7" Canvas.Left="14" Canvas.Top="3"
                                           RadiusX="1" RadiusY="1"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           StrokeThickness="1.45"/>
                                <Rectangle Width="7" Height="7" Canvas.Left="3" Canvas.Top="14"
                                           RadiusX="1" RadiusY="1"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           StrokeThickness="1.45"/>
                                <Rectangle Width="7" Height="7" Canvas.Left="14" Canvas.Top="14"
                                           RadiusX="1" RadiusY="1"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           StrokeThickness="1.45"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource SidebarBackground}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="10,8,10,8">
                    <Grid x:Name="ExplorerPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="EXPLORER"
                                       Style="{StaticResource PanelTitle}"
                                       VerticalAlignment="Center"
                                       DockPanel.Dock="Left"/>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        DockPanel.Dock="Right">
                                <Button Style="{StaticResource ExplorerActionButton}"
                                        ToolTip="New File"
                                        Click="NewFile_Click">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="16" Height="16">
                                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1"
                                                  Data="M3,2 L10,2 L13,5 L13,14 L3,14 Z M10,2 L10,6 L13,6"/>
                                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1"
                                                  Data="M6.5,9.5 L11.5,9.5 M9,7 L9,12"/>
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Button Style="{StaticResource ExplorerActionButton}"
                                        ToolTip="New Folder"
                                        Click="NewFolder_Click">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="16" Height="16">
                                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1"
                                                  Data="M1.5,3.5 L6.5,3.5 L8,5.5 L14.5,5.5 L14.5,13 L1.5,13 Z"/>
                                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1"
                                                  Data="M8,7.5 L8,11.5 M6,9.5 L10,9.5"/>
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Button Style="{StaticResource ExplorerActionButton}"
                                        ToolTip="Refresh Explorer"
                                        Click="RefreshExplorer_Click">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="16" Height="16">
                                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1"
                                                  Data="M13.5,5.5 A6,6 0 1 0 13.5,10.5 M13.5,2.5 L13.5,5.5 L10.5,5.5"/>
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Button Style="{StaticResource ExplorerActionButton}"
                                        ToolTip="Collapse Folders"
                                        Click="CollapseFolders_Click">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="16" Height="16">
                                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1"
                                                  Data="M1.5,3 L8.5,3 M1.5,7 L8.5,7 M1.5,11 L8.5,11"/>
                                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1"
                                                  Data="M11,5 L13.5,7.5 L11,10"/>
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock x:Name="WorkspaceLabel" Grid.Row="1"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   Margin="0,0,0,8"/>
                        <TreeView x:Name="ExplorerTree" Grid.Row="2"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Foreground="{StaticResource PrimaryText}"/>
                    </Grid>

                    <Grid x:Name="SearchPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="SEARCH"
                                   Style="{StaticResource PanelTitle}"
                                   Margin="0,0,0,10"/>
                        <DockPanel Grid.Row="1" Margin="0,0,0,8">
                            <Button Content="Find" Padding="8,3"
                                    Click="SearchButton_Click"
                                    DockPanel.Dock="Right"/>
                            <TextBox x:Name="SearchBox" Height="27"
                                     VerticalContentAlignment="Center"
                                     KeyDown="SearchBox_KeyDown"/>
                        </DockPanel>
                        <ListBox x:Name="SearchResults" Grid.Row="2"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource PrimaryText}"
                                 MouseDoubleClick="SearchResults_MouseDoubleClick"/>
                    </Grid>

                    <Grid x:Name="SourceControlPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="SOURCE CONTROL"
                                   Style="{StaticResource PanelTitle}"
                                   Margin="0,0,0,10"/>
                        <Button Grid.Row="1" Content="Refresh"
                                HorizontalAlignment="Left"
                                Padding="8,3"
                                Margin="0,0,0,10"
                                Click="RefreshSourceControl_Click"/>
                        <TextBox x:Name="SourceControlOutput" Grid.Row="2"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource PrimaryText}"/>
                    </Grid>

                    <Grid x:Name="ExtensionsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="EXTENSIONS"
                                   Style="{StaticResource PanelTitle}"
                                   Margin="0,0,0,10"/>
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="No extensions installed."
                                       Margin="0,4"/>
                            <TextBlock Text="Extension support is not configured for this workspace."
                                       Foreground="{StaticResource SecondaryText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="2"
                          Width="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="{StaticResource BorderBrush}"
                          ShowsPreview="False"/>

            <Grid Grid.Column="3" Background="{StaticResource EditorBackground}">
                <TabControl x:Name="EditorTabs"
                            SelectionChanged="EditorTabs_SelectionChanged"
                            Background="{StaticResource EditorBackground}"
                            BorderThickness="0"/>
                <StackPanel x:Name="WelcomePanel"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            IsHitTestVisible="False">
                    <TextBlock Text="KEYCE CODE"
                               FontSize="38"
                               FontWeight="Bold"
                               Foreground="#6C8CFF"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Your code. Your environment."
                               FontSize="14"
                               Foreground="{StaticResource SecondaryText}"
                               Margin="0,10"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Open a file from the Explorer to get started."
                               FontSize="12"
                               Foreground="{StaticResource SecondaryText}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="3"
                Background="{StaticResource SidebarBackground}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel Margin="15">
                <StackPanel x:Name="BottomPanelTabs"
                            DockPanel.Dock="Top"
                            Orientation="Horizontal"
                            Margin="0,0,0,12">
                    <Button x:Name="ProblemsTab"
                            Content="PROBLEMS"
                            Style="{StaticResource BottomPanelTab}"
                            Tag="Problems"
                            Click="BottomPanelTab_Click"/>
                    <Button x:Name="OutputTab"
                            Content="OUTPUT"
                            Style="{StaticResource BottomPanelTab}"
                            Tag="Output"
                            Click="BottomPanelTab_Click"/>
                    <Button x:Name="DebugConsoleTab"
                            Content="DEBUG CONSOLE"
                            Style="{StaticResource BottomPanelTab}"
                            Tag="Debug Console"
                            Click="BottomPanelTab_Click"/>
                    <Button x:Name="TerminalTab"
                            Content="TERMINAL"
                            Style="{StaticResource BottomPanelTab}"
                            Tag="Terminal"
                            Foreground="{StaticResource AccentBrush}"
                            Click="BottomPanelTab_Click"/>
                </StackPanel>
                <Grid>
                    <TextBox x:Name="ProblemsContent"
                             Text="No problems detected."
                             IsReadOnly="True"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource SecondaryText}"
                             FontFamily="Consolas"
                             FontSize="12"
                             Visibility="Collapsed"/>
                    <TextBox x:Name="OutputContent"
                             Text="No output to display."
                             IsReadOnly="True"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource SecondaryText}"
                             FontFamily="Consolas"
                             FontSize="12"
                             Visibility="Collapsed"/>
                    <TextBox x:Name="DebugConsoleContent"
                             Text="Debug console is ready."
                             IsReadOnly="True"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource SecondaryText}"
                             FontFamily="Consolas"
                             FontSize="12"
                             Visibility="Collapsed"/>
                    <TextBox x:Name="TerminalContent"
                             Text="Terminal will appear here..."
                             IsReadOnly="True"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource SecondaryText}"
                             FontFamily="Consolas"
                             FontSize="12"/>
                </Grid>
            </DockPanel>
        </Border>

        <Border Grid.Row="4" Background="{StaticResource AccentBrush}">
            <DockPanel Margin="10,0">
                <TextBlock x:Name="StatusText" Text="Ready"
                           VerticalAlignment="Center" FontSize="10"/>
                <TextBlock Text="KEYCE CODE"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="10"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
